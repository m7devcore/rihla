# Copy this file to .env (or .dev.vars for Cloudflare local dev) and fill in the values.
# Never commit real values. Production secrets are set in the Cloudflare dashboard.

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (used for sitemap, canonical links and hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional tracking IDs (leave empty to disable; they can also be set in the admin panel)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
